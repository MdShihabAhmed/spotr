# Copy to .env and fill in. Values below match docker-compose.yml for local dev.
DATABASE_URL=postgresql://forcesai_user:password@localhost:5432/forcesai
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                          # only needed if using Qdrant Cloud

# LLM — provider-agnostic (any OpenAI-compatible endpoint). Defaults below target
# Google Gemini's FREE tier. Get a free key (no card): https://aistudio.google.com/apikey
# To use OpenAI instead: leave LLM_BASE_URL empty and set gpt-* model names.
OPENAI_API_KEY=                          # your Gemini API key from AI Studio goes here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Use the "-latest" aliases: specific versions (e.g. gemini-2.5-flash) get retired for
# new accounts and start 404-ing. Verify what your key can call: `uv run python check_llm.py`.
LLM_MODEL_STRONG=gemini-flash-latest      # hint gen, pitfall reasoning, brute-force gen
LLM_MODEL_FAST=gemini-flash-lite-latest   # test-case gen, formatting, cheap tasks
EMBEDDING_MODEL=gemini-embedding-001      # Gemini's free embedding model (used later)

LANGFUSE_PUBLIC_KEY=                      # optional — tracing is skipped if unset
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com # or your self-hosted Langfuse URL

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated frontend origins. The browser sends credentials, so "*" is not
# usable. Add the deployed frontend URL here in production.
CORS_ORIGINS=http://localhost:5173
