# Copy to .env and fill in. Values below match docker-compose.yml for local dev.
DATABASE_URL=postgresql://forcesai_user:password@localhost:5432/forcesai
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                          # only needed if using Qdrant Cloud

JUDGE0_URL=http://localhost:2358         # self-hosted Judge0, or hosted API URL
JUDGE0_API_KEY=                          # if using RapidAPI/Sulu-hosted Judge0

OPENAI_API_KEY=                          # sk-...
LLM_MODEL_STRONG=gpt-5.2                 # hint gen, pitfall reasoning, brute-force gen
LLM_MODEL_FAST=gpt-5-mini                # test-case gen, formatting, cheap tasks
EMBEDDING_MODEL=text-embedding-3-small

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated frontend origins. The browser sends credentials, so "*" is not
# usable. Add the deployed frontend URL here in production.
CORS_ORIGINS=http://localhost:5173

STRESS_TEST_MAX_CASES=30
STRESS_TEST_DAILY_LIMIT_PER_USER=10
