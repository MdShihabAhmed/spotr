# Copy to .env and fill in. Values below match docker-compose.yml for local dev.
DATABASE_URL=postgresql://forcesai_user:password@localhost:5432/forcesai
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                          # only needed if using Qdrant Cloud

# LLM — provider-agnostic (any OpenAI-compatible endpoint). Defaults below target
# Google Gemini's FREE tier. Get a free key (no card): https://aistudio.google.com/apikey
# To use OpenAI instead: leave LLM_BASE_URL empty and set gpt-* model names.
#
# THIS IS THE GLOBAL DEFAULT — one key here powers every task. You can route individual
# tasks elsewhere with the per-task overrides further down (see README "LLM configuration").
OPENAI_API_KEY=                          # your Gemini API key from AI Studio goes here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Use the "-latest" aliases: specific versions (e.g. gemini-2.5-flash) get retired for
# new accounts and start 404-ing. Verify what your key can call: `uv run python check_llm.py`.
LLM_MODEL_STRONG=gemini-flash-latest      # default for normalize / hints / chat
LLM_MODEL_FAST=gemini-flash-lite-latest   # default for the cheap disclosure judge
EMBEDDING_MODEL=gemini-embedding-001      # default for grounding embeddings

# --- Per-task LLM overrides (ALL optional) -----------------------------------
# Leave blank to use the global default above. Set only what you want to route
# elsewhere — e.g. run the tutor chat on a paid model while keeping the rest on Gemini
# free. Each task has _MODEL, _BASE_URL, _API_KEY. Feature needs (see README):
#   normalize → chat + vision + structured output   hints/judge → chat + structured output
#   chat      → chat + streaming                     embedding  → an embeddings endpoint
# NORMALIZE_MODEL=      NORMALIZE_BASE_URL=      NORMALIZE_API_KEY=
# HINTS_MODEL=          HINTS_BASE_URL=          HINTS_API_KEY=
# CHAT_MODEL=           CHAT_BASE_URL=           CHAT_API_KEY=
# JUDGE_MODEL=          JUDGE_BASE_URL=          JUDGE_API_KEY=
# EMBEDDING_BASE_URL=   EMBEDDING_API_KEY=   (embedding model is EMBEDDING_MODEL above)

# Grounding RAG (retrieval over the openly-licensed corpora → cited tutor guidance).
# EMBEDDING_DIM must match the model's output: gemini-embedding-001 → 3072,
# text-embedding-3-small → 1536. The Qdrant collection name encodes EMBEDDING_MODEL, so
# changing the model uses a fresh collection (re-seed) rather than mixing vector spaces.
EMBEDDING_DIM=3072
EMBEDDING_BATCH_SIZE=32                    # texts per embeddings call (free-tier friendly)
CORPORA_DIR=./corpora                     # where `python -m app.ingestion.grounding` clones corpora
GROUNDING_TOP_K=4                         # grounding chunks retrieved per tutor turn

LANGFUSE_PUBLIC_KEY=                      # optional — tracing is skipped if unset
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com # or your self-hosted Langfuse URL

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated frontend origins. The browser sends credentials, so "*" is not
# usable. Add the deployed frontend URL here in production.
CORS_ORIGINS=http://localhost:5173
